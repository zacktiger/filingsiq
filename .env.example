# Copy to .env and fill in. .env is gitignored.

# --- Answer generation (Groq free tier) --------------------------------------
# Free API key at https://console.groq.com/keys - signup only, no card.
#
# Free tier limits verified Sept 2026 for openai/gpt-oss-120b:
#   30 requests/min · 1,000 requests/day · 8K tokens/min · 200K tokens/day
#
# The binding limit is 200K tokens/DAY. At roughly 2K tokens per question that
# is about 100 questions per day, i.e. one full Phase 2 eval run - so the eval
# and interactive use draw on the same budget. The client throttles itself to
# stay under 30 req/min (see REQUESTS_PER_SECOND).
GROQ_API_KEY=
ANSWER_MODEL=openai/gpt-oss-120b

# Reasoning depth for gpt-oss: low | medium | high. Leave blank to disable.
ANSWER_EFFORT=medium

# MUST stay 0. ChatGroq defaults to 0.7, and this task copies figures out of
# filings verbatim - randomness here produces plausible, wrong numbers.
ANSWER_TEMPERATURE=0

ANSWER_MAX_TOKENS=1024

# Client-side throttle in requests/second. Free tier allows 0.5/sec (30/min);
# 0.4 leaves headroom so a batch of eval questions queues instead of 429ing.
REQUESTS_PER_SECOND=0.4

# --- Embeddings (local, no API key needed) -----------------------------------
# Anthropic has no embeddings API, so embeddings run locally via sentence-transformers.
#
# Measured on this machine (CPU only - torch 2.14.0+cpu, no CUDA, 8 threads):
#
#   model                    dim   cached load   per chunk   10k chunks
#   BAAI/bge-m3             1024   slow          406 ms      ~68 min
#   BAAI/bge-small-en-v1.5   384   6.5 s          21 ms      ~3.5 min
#
# bge-m3 also needs a one-time ~2.2GB download (~15 min).
#
# bge-small is the default for the Phase 1 slice because Phases 2-3 re-index
# repeatedly to measure whether retrieval changes help, and a 19x slower loop
# discourages exactly the measurement this project is built around. Switch to
# bge-m3 for the final measured run, or once a GPU is available.
#
# IMPORTANT: the dimension is baked into the Qdrant collection at build time.
# The collection name is derived from the model (filings_bge_small_en_v15 vs
# filings_bge_m3), so the two indexes coexist and switching is an env change
# plus a one-off `ingest.py --recreate` - never a silent mismatch.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Qdrant ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- Retrieval ---------------------------------------------------------------
TOP_K=5
